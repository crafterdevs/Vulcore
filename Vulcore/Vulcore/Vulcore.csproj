<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<PackageId>VulCore</PackageId>
	<Version>1.0.1</Version>
	<Authors>Crafter Devs</Authors>
	<Company>Crafter Devs</Company>
	<Description>Bu paket CrafterDevs için geliştirilmiştir.</Description>
	<PackageTags>core;base;simple</PackageTags>
	<PackageProjectUrl>https://github.com/crafterdevs/Vulcore</PackageProjectUrl>
	<RepositoryUrl>https://github.com/crafterdevs/Vulcore</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageReadmeFile>readme.md</PackageReadmeFile>
	<Title>VulCore</Title>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

	
  <ItemGroup>
    <ProjectReference Include="..\Vulcore.Domain\Vulcore.Domain.csproj" />
  </ItemGroup>

</Project>
